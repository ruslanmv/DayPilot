# =============================================================================
# DayPilot Enterprise — local development environment defaults
# =============================================================================
# Copy to `.env` and adjust for your environment. Never commit real secrets.
# Values consumed directly by service code are marked [code]; the rest are
# forward-looking placeholders for connectors introduced by the production
# plan (docs/production-plan.md).

# --- Core runtime --------------------------------------------------------------
DAYPILOT_ENV=local
DAYPILOT_DOMAIN=daypilot.ruslanmv.com
DAYPILOT_LOG_LEVEL=INFO                    # [code] observability logging level
DAYPILOT_API_HOST=0.0.0.0
DAYPILOT_API_PORT=8080
DAYPILOT_LOCAL_DATA=./local_data

# --- AI profile & personalization ---------------------------------------------
# DayPilot owns a server-side, per-workspace AI profile for the signed-in person
# (distinct from a HomePilot persona). When enabled, the assistant/planner receive
# a bounded, purpose-limited, consent-gated projection of that profile — never the
# raw row. Set to a falsey value to disable personalization entirely; per-category
# consent still applies when it is on.
DAYPILOT_PROFILE_CONTEXT_ENABLED=true

# --- Identity, RBAC & secrets (batch B11) -------------------------------------
# Local-first: with auth disabled every request runs as the workspace owner.
# Enable and map bearer tokens to roles for team deployments.
DAYPILOT_AUTH_ENABLED=false
DAYPILOT_AUTH_TOKENS=                       # e.g. "tokenA:owner,tokenB:reviewer"
# Roles: read_only < reviewer < operator < owner
# Secrets are read from the environment (or a managed backend) and never stored
# in the DB, logs, traces, or prompts. Never commit real secret values.

# --- Governance & approval posture (safe by default) --------------------------
DAYPILOT_REQUIRE_APPROVAL=true             # [code] gate write actions behind approval
DAYPILOT_WRITE_ENABLED=false               # [code] disable mutating tool execution
DAYPILOT_DRY_RUN=true                      # mutating MCP actions start in dry-run
DAYPILOT_MCP_WRITE_ENABLED=false           # MCP host write-behavior master switch
DAYPILOT_MCP_DRY_RUN=true                  # MCP host dry-run master switch

# --- Persistence --------------------------------------------------------------
DATABASE_URL=sqlite:///./local_data/sqlite/daypilot.db   # [code] app/knowledge DB
POSTGRES_DB=daypilot
POSTGRES_USER=daypilot
POSTGRES_PASSWORD=daypilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Runtime dependencies -----------------------------------------------------
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333             # [code] vector index endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://observability:4318
PROMETHEUS_MULTIPROC_DIR=/tmp/daypilot_prometheus

# --- Internal service URLs ----------------------------------------------------
API_GATEWAY_URL=http://api-gateway:8080
ORCHESTRATOR_URL=http://orchestrator:8002
MCP_HOST_URL=http://mcp-host:8003
KNOWLEDGE_SERVICE_URL=http://knowledge-service:8004
MODEL_SERVING_URL=http://model-serving:8005
VOICE_GATEWAY_URL=http://voice-gateway:8006
OBSERVABILITY_URL=http://observability:8010

# --- Model serving (legacy direct backends) -----------------------------------
DAYPILOT_MODEL_BACKEND=mock                # [code] mock | ollama | vllm | ollabridge
OLLAMA_BASE_URL=http://host.docker.internal:11434   # [code]
OLLAMA_MODEL=llama3.1                       # [code]
VLLM_BASE_URL=http://model-serving:8000/v1  # [code]
VLLM_MODEL=local-model                      # [code]
# VLLM_API_KEY=                             # [code] optional

# --- Ollabridge (default LLM provider layer — batch B5) -----------------------
# One OpenAI-compatible URL + key routes local Ollama, remote GPUs, and cloud
# accounts. DayPilot pairs with either the local gateway or Ollabridge Cloud —
# both expose the same /v1/chat/completions Bearer surface.
OLLABRIDGE_MODE=local                       # local | cloud — picks the default endpoint
OLLABRIDGE_URL=http://localhost:11435/v1    # local gateway (or set explicitly for any node)
OLLABRIDGE_CLOUD_URL=https://ruslanmv-ollabridge.hf.space/v1  # live OllaBridge Cloud; used when OLLABRIDGE_MODE=cloud
OLLABRIDGE_CLOUD_WEB_URL=                    # web app for cloud login page (defaults to the cloud host)
OLLABRIDGE_API_KEY=                         # sk-ollabridge-… (local) or ob_live_…/ob_test_… (cloud)
OLLABRIDGE_DEFAULT_MODEL=llama3.1
OLLABRIDGE_PRIVACY_TIER=local              # local | hybrid | cloud default routing

# --- HomePilot agents integration (remote runtime) ----------------------------
# HomePilot owns the agents; DayPilot connects to them and manages their work.
# These flags are ADMIN OVERRIDES: leave a flag UNSET to use its default. The
# integration is a first-class experience and is ON by default — set RUNTIME to a
# falsey value only to hard-disable it for a deployment.
#   RUNTIME / SYNC / CHAT  default: ON   (uncomment to pin explicitly)
#   DELEGATION / IMPORTS   default: OFF
# DAYPILOT_HOMEPILOT_RUNTIME_ENABLED=true     # master switch for the HomePilot agent runtime
# DAYPILOT_HOMEPILOT_SYNC_ENABLED=true        # sync persona references from HomePilot
# DAYPILOT_HOMEPILOT_CHAT_ENABLED=true        # send chat turns to a HomePilot persona
DAYPILOT_HOMEPILOT_DELEGATION_ENABLED=false   # manager→worker persona delegation (default: off)
DAYPILOT_HOMEPILOT_IMPORTS_ENABLED=false      # offline .hpersona importer fallback (default: off)
HOMEPILOT_BASE_URL=http://homepilot:7860/api  # side-by-side default; host install → http://host.docker.internal:7860/api
# HOMEPILOT_API_KEY is never read from env in production — it is stored in the
# credential store by secret reference. Set it only for local dev/test convenience.
HOMEPILOT_API_KEY=

# --- Coding workflow bridges (batches B6/B7) ----------------------------------
DAYPILOT_CODING_EXECUTOR=gitpilot          # default retro-compatible bridge
# GitPilot (A2A-secured runner: POST /api/v1/gitpilot/runs)
GITPILOT_URL=http://localhost:8200
GITPILOT_API_KEY=
GITPILOT_DEFAULT_MODE=ask                  # ask | auto | plan (ask = approval-gated)
# Optional executors (opt-in; DayPilot falls back to GitPilot when disabled)
CLAUDE_CODE_ENABLED=false
CLAUDE_CODE_URL=http://localhost:8210
CLAUDE_CODE_API_KEY=
CODEX_ENABLED=false
CODEX_URL=http://localhost:8220
CODEX_API_KEY=
# Per-project executor overrides, e.g. "proj-a=claude_code,proj-b=codex"
DAYPILOT_CODING_PROJECT_OVERRIDES=

# --- Matrix Designer (planner / design reviewer — batch B8) -------------------
# Matrix Designer's own service listens on 8077 by default (MATRIX_DESIGNER_PORT).
# Point this at wherever it is reachable; the API key is optional and is only
# required when the designer itself sets MATRIX_DESIGNER_API_KEY.
MATRIX_DESIGNER_URL=http://localhost:8077
MATRIX_DESIGNER_API_KEY=

# --- Email (optional, feature-flagged module — batch B9) ----------------------
# The Email tab is a single optional, non-destructive DayPilot feature. Disabled
# by default; DayPilot works fully without it.
DAYPILOT_EMAIL_ENABLED=false
DAYPILOT_EMAIL_PROVIDER=mock               # mock | mailu | imap_smtp | gmail | microsoft
DAYPILOT_EMAIL_ALLOW_SEND=true             # sending still requires per-action approval
DAYPILOT_EMAIL_ALLOW_DELETE=false          # destructive: off by default
DAYPILOT_EMAIL_ALLOW_EXPUNGE=false         # destructive: off by default
EMAIL_USERNAME=
EMAIL_PASSWORD=                            # or an OAuth token for gmail/microsoft
SMTP_HOST=
SMTP_PORT=587
# Email Sentinel classifier
EMAIL_PROVIDER=none                        # none | gmail | graph | imap
EMAIL_SENTINEL_ENABLED=false
# Gmail / Google mailbox OAuth (authorization-code + PKCE, XOAUTH2 for IMAP/SMTP).
# REDIRECT_URI must exactly match the console entry and point at DayPilot's
# callback: <public-origin>/v1/email/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Microsoft 365 mailbox OAuth (XOAUTH2). Redirect: …/v1/email/oauth/microsoft/callback
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REDIRECT_URI=
MS_GRAPH_TENANT_ID=

# --- Calendar connections (Meeting Intelligence) ------------------------------
# The same app registrations as above — same client id and secret — but the
# redirect is per flow and must be registered separately in the provider
# console. Both point at DayPilot's calendar callback:
#   <public-origin>/v1/calendar/callback
# First consent is read-only (Calendars.Read / calendar.readonly); calendar
# writes stay approval-gated in DayPilot and are a separate, later consent.
MS_GRAPH_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_REDIRECT_URI=
# IMAP fallback
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# --- Calendar providers (batch B9) --------------------------------------------
CALENDAR_PROVIDER=none                      # none | google | m365
GOOGLE_CALENDAR_ENABLED=false
M365_CALENDAR_ENABLED=false

# --- Document sources (batch B10) ---------------------------------------------
DAYPILOT_LOCAL_SOURCES_ENABLED=false        # explicit folder grants, read+index only
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=

# --- Voice (future) -----------------------------------------------------------
DAYPILOT_ASR_BACKEND=mock                   # [code]
DAYPILOT_TTS_BACKEND=mock                   # [code]

# --- Web shell (Vite build-time; product stabilization) -----------------------
# Clean, real-data by default. Set to true to load sample/demo content and show
# a visible "Demo mode" badge. Demo data is never shown unless this is true.
VITE_DAYPILOT_DEMO_MODE=false
# Base URL of the API gateway the web shell talks to (same-origin /api default).
VITE_DAYPILOT_API_BASE=/api
# Workspace the shell operates on (single-tenant default for local dev).
VITE_DAYPILOT_WORKSPACE_ID=default

# --- Identity & sessions (Batch 1 / Issue 6) ----------------------------------
# Local-first default: auth is NOT enforced, so a single-user install works with
# zero setup. For any deployment with real login, enable enforcement — signing
# out then always lands on the login page instead of anonymous mode.
DAYPILOT_REQUIRE_SESSION=false
# Set to true when serving over HTTPS so session cookies are Secure-only.
DAYPILOT_COOKIE_SECURE=false
