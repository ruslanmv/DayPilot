# DayPilot Enterprise local development defaults
DAYPILOT_ENV=local
DAYPILOT_DOMAIN=daypilot.ruslanmv.com
DAYPILOT_LOG_LEVEL=INFO
DAYPILOT_REQUIRE_APPROVAL=true
DAYPILOT_WRITE_ENABLED=false
DAYPILOT_DRY_RUN=true

# Persistence
DATABASE_URL=sqlite:///./local_data/sqlite/daypilot.db
POSTGRES_DB=daypilot
POSTGRES_USER=daypilot
POSTGRES_PASSWORD=daypilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Runtime dependencies
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
OTEL_EXPORTER_OTLP_ENDPOINT=http://observability:4318
PROMETHEUS_MULTIPROC_DIR=/tmp/daypilot_prometheus

# Service URLs
API_GATEWAY_URL=http://api-gateway:8080
ORCHESTRATOR_URL=http://orchestrator:8002
MCP_HOST_URL=http://mcp-host:8003
KNOWLEDGE_SERVICE_URL=http://knowledge-service:8004
MODEL_SERVING_URL=http://model-serving:8005
VOICE_GATEWAY_URL=http://voice-gateway:8006
OBSERVABILITY_URL=http://observability:8010

# Model-serving defaults
DAYPILOT_MODEL_BACKEND=mock
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
VLLM_BASE_URL=http://model-serving:8000/v1
VLLM_MODEL=local-model

# Voice defaults
DAYPILOT_ASR_BACKEND=mock
DAYPILOT_TTS_BACKEND=mock
