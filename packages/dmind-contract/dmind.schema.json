{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matrixhub.io/schemas/dmind/v1",
  "title": "dmind/v1 diagram",
  "description": "Portable graph. Branch edges additionally require one parent per node and no cycles. Max UTF-8 encoded size: 2 MB. Unknown metadata is retained.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "dmind/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "enum": [
        "mindmap",
        "flowchart",
        "system"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 4000,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "maxLength": 20000
        },
        "collapsed": {
          "type": "boolean"
        },
        "position": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "y": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            }
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "source": {
          "$ref": "#/$defs/safeId"
        },
        "target": {
          "$ref": "#/$defs/safeId"
        },
        "kind": {
          "enum": [
            "branch",
            "flow",
            "dependency",
            "relationship"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
