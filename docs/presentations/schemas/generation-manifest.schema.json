{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daypilot.example/schemas/presentations/generation-manifest.schema.json",
  "title": "DayPilot generation-manifest (draft)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "daypilot.generation-manifest/v1"
    },
    "fixture_only": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "deck_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "deck_spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "brand_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ]
    },
    "template_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ]
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "version",
        "source_sha256"
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "font_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "version",
        "font_manifest_sha256"
      ]
    },
    "source_snapshot_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rights": {
            "type": "string",
            "enum": [
              "company_owned",
              "licensed",
              "fixture_placeholder"
            ]
          }
        },
        "required": [
          "id",
          "sha256",
          "rights"
        ]
      },
      "minItems": 0,
      "maxItems": 200
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pptx",
              "pdf",
              "slide_png",
              "contact_sheet",
              "source_bundle",
              "quality_report"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "kind",
          "sha256",
          "media_type"
        ]
      },
      "minItems": 1,
      "maxItems": 200
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "pptx_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "slides_reviewed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "total_slides": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "hard_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "not_evaluated",
            "failed",
            "review_ready"
          ]
        },
        "review_method": {
          "type": "string",
          "enum": [
            "none",
            "automated",
            "human",
            "combined"
          ]
        }
      },
      "required": [
        "receipt_id",
        "pptx_sha256",
        "slides_reviewed",
        "total_slides",
        "hard_failure_count",
        "status",
        "review_method"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "fixture_only",
    "id",
    "deck_id",
    "revision_id",
    "run_id",
    "created_at",
    "deck_spec_sha256",
    "brand_ref",
    "template_ref",
    "compiler",
    "adapter",
    "renderer",
    "source_snapshot_hashes",
    "assets",
    "outputs",
    "quality",
    "limitations"
  ]
}
