{
  "type": "APL",
  "version": "2023.2",
  "description": "DRAFT — DayPilot Today summary for Echo Show (landscape). Not deployed. Data shape: summary.sample.json.",
  "theme": "dark",
  "mainTemplate": {
    "parameters": ["payload"],
    "item": {
      "type": "Container",
      "width": "100vw",
      "height": "100vh",
      "paddingLeft": "4vw",
      "paddingRight": "4vw",
      "paddingTop": "5vh",
      "paddingBottom": "5vh",
      "items": [
        {
          "type": "Text",
          "text": "${payload.summary.greeting}",
          "fontSize": "${viewport.width > 1280 ? '52dp' : '36dp'}",
          "fontWeight": "600",
          "color": "#F4F4F5"
        },
        {
          "type": "Text",
          "text": "Now · ${payload.summary.now.title}",
          "paddingTop": "3vh",
          "fontSize": "${viewport.width > 1280 ? '40dp' : '28dp'}",
          "color": "#F4F4F5",
          "maxLines": 2
        },
        {
          "type": "Text",
          "text": "Next · ${payload.summary.next.title}",
          "paddingTop": "1vh",
          "fontSize": "${viewport.width > 1280 ? '28dp' : '22dp'}",
          "color": "#B4B4BB",
          "maxLines": 1
        },
        {
          "type": "Sequence",
          "scrollDirection": "horizontal",
          "paddingTop": "5vh",
          "height": "30vh",
          "width": "100%",
          "data": "${payload.summary.tiles}",
          "item": {
            "type": "Frame",
            "width": "21vw",
            "height": "100%",
            "borderRadius": "24dp",
            "borderWidth": "1dp",
            "borderColor": "#26262B",
            "backgroundColor": "#0E0E10",
            "item": {
              "type": "Container",
              "paddingLeft": "24dp",
              "paddingTop": "24dp",
              "items": [
                { "type": "Text", "text": "${data.value}", "fontSize": "64dp", "fontWeight": "600", "color": "${data.color}" },
                { "type": "Text", "text": "${data.label}", "fontSize": "24dp", "color": "#B4B4BB" }
              ]
            }
          }
        },
        {
          "type": "Text",
          "text": "Updated ${payload.summary.updatedAt} · decisions are made in the DayPilot app",
          "paddingTop": "3vh",
          "fontSize": "20dp",
          "color": "#8A8A93"
        }
      ]
    }
  }
}
